# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender for outbound transactional email.
# Must be a verified domain/identity in Resend.
# Example: "Forsyth4Defense <noreply@forsyth4defense.com>"
EMAIL_FROM=

# Comma-separated list of contact-form recipients.
# Example: john@forsyth4defense.com,office@forsyth4defense.com
EMAIL_TO=
